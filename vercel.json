{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/a/:id",
      "destination": "/api/alert-page?id=:id"
    },
    {
      "source": "/alert/:id",
      "destination": "/alert/index.html?id=:id"
    }
  ],
  "images": {
    "sizes": [
      64,
      128,
      256,
      384,
      640,
      828,
      1080
    ],
    "localPatterns": [
      {
        "pathname": "^/assets/.*$",
        "search": ""
      }
    ],
    "minimumCacheTTL": 86400,
    "qualities": [
      82
    ],
    "formats": [
      "image/webp"
    ],
    "dangerouslyAllowSVG": false
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
